# Haru frontend env (Vite). Copy to .env and adjust.
# Expose only VITE_* vars to the client — anything else is ignored.

# Korean speech-to-text backend base URL (the RTX 3090 service in backend/).
# Unset -> the client defaults to http://127.0.0.1:8765 (local GPU host).
# Production example: https://stt.your-host.com
VITE_STT_API_BASE_URL=http://127.0.0.1:8765

# Local personal-memory RAG service. `npm run dev:local` injects a temporary
# matching token automatically; manual launches should set the same value in
# rag_backend/.env and the Vite environment.
VITE_RAG_API_BASE_URL=http://127.0.0.1:8000
VITE_RAG_API_TOKEN=
