# Haru frontend env (Vite). Copy to .env and adjust.
# Expose only VITE_* vars to the client — anything else is ignored.

# Deployment market is part of the frontend build. It fixes locale, currency,
# time zone, speech language, content pack, and browser storage namespace.
# Set the matching value in each Vercel project; unset -> local Korean default.
# VITE_HARU_MARKET=jp

# Market deployments lock their language by default. Enable only for local QA.
# VITE_ALLOW_LANGUAGE_SWITCH=0

# Synthetic persona and pre-authorized fixture consents. Keep 0/unset for real
# users; use 1 only in an isolated demo build with no real participant data.
# VITE_DEMO_MODE=0

# Fallback for an unconfigured local build only. A configured market overrides
# both this value and any language saved by a different browser session.
# VITE_DEFAULT_LOCALE=ja

# Korean speech-to-text backend base URL (the RTX 3090 service in backend/).
# Unset -> the client defaults to http://127.0.0.1:8765 (local GPU host).
# Production example: https://stt.your-host.com
VITE_STT_API_BASE_URL=http://127.0.0.1:8765

# Local personal-memory RAG service. `npm run dev:local` injects a temporary
# matching token automatically; manual launches should set the same value in
# rag_backend/.env and the Vite environment.
VITE_RAG_API_BASE_URL=http://127.0.0.1:8000
VITE_RAG_API_TOKEN=

# Haru country-isolated data API (server-only; never prefix with VITE_).
# Configure a separate Supabase project, secret set, and voice bucket for each
# KR/JP deployment.
# HARU_MARKET=jp
# SUPABASE_URL=https://your-country-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# HARU_ENROLLMENT_CODE_PEPPER=
# HARU_COUNSELOR_API_SECRET=
# CRON_SECRET=
# HARU_VOICE_STORAGE_BUCKET=haru-voice-jp
