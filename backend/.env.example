# Haru Qwen3-ASR backend configuration. Defaults target a local RTX 3090.
# Paths are resolved relative to backend/ and must already contain downloaded
# checkpoints. Startup never downloads a model.

STT_MODEL_ID=Qwen/Qwen3-ASR-1.7B
STT_MODEL_REVISION=7278e1e70fe206f11671096ffdd38061171dd6e5
STT_MODEL_PATH=models/Qwen3-ASR-1.7B

STT_ALIGNER_ID=Qwen/Qwen3-ForcedAligner-0.6B
STT_ALIGNER_REVISION=c7cbfc2048c462b0d63a45797104fc9db3ad62b7
STT_ALIGNER_PATH=models/Qwen3-ForcedAligner-0.6B

# auto resolves to cuda:0 + bfloat16 on the RTX 3090, otherwise CPU + float32.
STT_DEVICE=auto
STT_DTYPE=auto
# Qwen uses canonical language names. API/record output stays BCP-47 ko-KR.
STT_LANGUAGE=Korean
STT_OUTPUT_LANGUAGE=ko-KR
STT_RETURN_TIMESTAMPS=true
STT_MAX_INFERENCE_BATCH_SIZE=1
STT_MAX_NEW_TOKENS=256
STT_WARMUP=true

STT_HOST=0.0.0.0
STT_PORT=8765

# Comma-separated allowed origins. Replace * before exposing beyond local dev.
STT_CORS_ORIGINS=*
STT_MAX_UPLOAD_MB=25
