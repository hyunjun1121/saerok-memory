# The key falls back to NexQ's Windows Credential Manager entry
# `NexQ:azure_speech`. STT_API_KEY overrides it when set.
STT_API_KEY=
STT_ENDPOINT=https://mai-transcribe-2-mnb9227.cognitiveservices.azure.com/speechtotext/transcriptions:transcribe?api-version=2025-10-15
STT_MODEL_ID=MAI-Transcribe-2
STT_OUTPUT_LANGUAGE=ko-KR

STT_HOST=127.0.0.1
STT_PORT=8765
STT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
STT_MAX_UPLOAD_MB=25
STT_MAX_AUDIO_SECONDS=65
STT_MAX_PENDING_REQUESTS=2
STT_QUEUE_RETRY_AFTER_SECONDS=1
