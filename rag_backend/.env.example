APP_ENV=development
DATABASE_URL=sqlite:///./data/haru.db
SEED_JSON_PATH=./data/haru_7day_admin_usage_records.json

NEO4J_ENABLED=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=haru-demo-password

EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
EMBEDDING_MODEL_PATH=./models/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_DIM=384

MIN_QUESTION_CONFIDENCE=0.80
QA_MIN_SIMILARITY=0.78
ALLOW_SENSITIVE_QUESTION_GENERATION=false
RAG_API_TOKEN=change-this-local-token
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
MAX_JSON_BYTES=5242880
