{
  "name": "haru",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "node scripts/dev-local-services.mjs",
    "build": "tsc -b && vite build",
    "capture:screens": "playwright test e2e/capture-application-screenshots.spec.ts --project=chromium",
    "check:haru-data": "node scripts/check-haru-7day-contract.mjs",
    "lint": "eslint .",
    "test": "npm run check:haru-data && vitest run",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "stt:install": "node scripts/run-python-service.mjs stt install",
    "stt:download": "node scripts/run-python-service.mjs stt download",
    "stt:dev": "node scripts/run-python-service.mjs stt dev",
    "stt:test": "node scripts/run-python-service.mjs stt test",
    "stt:smoke": "node scripts/run-python-service.mjs stt smoke",
    "rag:install": "node scripts/run-python-service.mjs rag install",
    "rag:download": "node scripts/run-python-service.mjs rag download",
    "rag:dev": "node scripts/run-python-service.mjs rag dev",
    "rag:test": "node scripts/run-python-service.mjs rag test",
    "rag:bootstrap": "node scripts/run-python-service.mjs rag bootstrap",
    "sample:voice:generate": "node scripts/generate-voice-pilot-sample.mjs",
    "sample:voice:analyze": "node scripts/voice-pilot-sample/analyze.mjs",
    "sample:voice:capture": "node scripts/voice-pilot-sample/capture-dashboard.mjs",
    "sample:voice:test": "node --test \"scripts/voice-pilot-sample/*.test.mjs\"",
    "sample:voice": "npm run sample:voice:generate && npm run sample:voice:analyze && npm run sample:voice:capture",
    "check:pilot": "node scripts/check-pilot-runtime.mjs",
    "predev:pilot": "npm run check:pilot",
    "dev:pilot": "node scripts/dev-japan-pilot.mjs",
    "start:pilot": "npm run build:pilot && npm run preview:pilot",
    "prepreview:pilot": "npm run check:pilot",
    "preview:pilot": "node scripts/dev-japan-pilot.mjs --preview",
    "test:pilot": "npm run test:pilot-local && node --test scripts/pilot-documentation.test.mjs && vitest run src/features/pilot src/app/pilot src/features/speech/useVoiceRecorder.test.ts src/components/ChoiceCard.test.tsx src/locales/copySafety.test.ts src/App.test.tsx",
    "test:pilot-local": "node --test scripts/pilot-local-store.test.mjs",
    "prebuild:pilot": "npm run check:pilot",
    "build:pilot": "tsc -b && vite build --mode japan-pilot",
    "docs:pilot": "node scripts/generate-japan-pilot-document.mjs && node scripts/generate-japan-pilot-tts-plan.mjs"
  },
  "dependencies": {
    "i18next": "^26.1.0",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.7",
    "react-router-dom": "^6.30.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  }
}
