# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# SQLite runtime sidecars created by local STT/RAG services.
*.db-shm
*.db-wal

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel

# Local cognitive-reference payloads. Keep small README/agents/metadata
# files trackable, but do not commit downloaded papers, datasets, cloned
# reference repositories, saved web pages, or local logs.
/cognitve-reference/code/
/cognitve-reference/data/
/cognitve-reference/logs/
/cognitve-reference/official-tools/
/cognitve-reference/papers/
/cognitve-reference/web-pages/

# Local scratch prompts and generated application screenshot batches.
/prompt.txt
/recovery_audit/
/피우다프로젝트/application_assets/auto_screenshots/
test-results/
playwright-report/

# Local browser profiles generated while capturing application screenshots.
# These may contain cookies, login databases, cache, and session state.
피우다프로젝트/application_assets/chrome-profile*/

# Generated render/cache artifacts.
피우다프로젝트/docx_render_check/
피우다프로젝트/docx_render_check_url/
피우다프로젝트/final/render_qa*/
피우다프로젝트/final/report_assets/
피우다프로젝트/**/__pycache__/
피우다프로젝트/**/*.pyc
피우다프로젝트/~$*

.vercel
